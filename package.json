{
	"name": "sphere-global",
	"version": "1.1.0",
	"description": "Sphere IT - Digital transformation partner in UAE & GCC. AI, automation, IT services, and talent augmentation.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"build": "cross-env NODE_OPTIONS=--no-deprecation next build",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start",
		"lint": "biome check --write",
		"format": "biome format --write",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"email:dev": "email dev --dir ./src/lib/emails/templates -p 3333",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"payload": "cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"auth:generate": "pnpx @better-auth/cli generate --config ./src/lib/auth/server.ts --yes --output ./src/server/schema/auth-generated.ts",
		"test": "pnpm run test:int && pnpm run test:e2e",
		"test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --no-experimental-strip-types\" pnpm exec playwright test --config=playwright.config.ts",
		"test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
	},
	"dependencies": {
		"@better-auth/passkey": "^1.5.6",
		"@bprogress/next": "^3.2.12",
		"@delmaredigital/payload-better-auth": "^0.6.9",
		"@hookform/resolvers": "^5.2.2",
		"@number-flow/react": "^0.6.0",
		"@openpanel/nextjs": "^1.4.0",
		"@payloadcms/db-postgres": "^3.81.0",
		"@payloadcms/email-nodemailer": "^3.81.0",
		"@payloadcms/next": "^3.81.0",
		"@payloadcms/plugin-search": "^3.81.0",
		"@payloadcms/plugin-seo": "^3.81.0",
		"@payloadcms/richtext-lexical": "^3.81.0",
		"@payloadcms/ui": "^3.81.0",
		"@react-email/components": "^1.0.11",
		"@t3-oss/env-nextjs": "^0.13.11",
		"better-auth": "^1.5.6",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"cross-env": "^10.1.0",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.2",
		"graphql": "^16.13.2",
		"gray-matter": "^4.0.3",
		"lucide-react": "^1.7.0",
		"motion": "^12.38.0",
		"next": "16.2.2",
		"next-mdx-remote": "^6.0.0",
		"next-themes": "^0.4.6",
		"nodemailer": "^8.0.4",
		"nuqs": "^2.8.9",
		"payload": "^3.81.0",
		"pg": "^8.20.0",
		"radix-ui": "latest",
		"rate-limiter-flexible": "^10.0.1",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.72.0",
		"react-lottie": "^1.2.10",
		"react-phone-number-input": "^3.4.16",
		"remark-gfm": "^4.0.1",
		"server-only": "^0.0.1",
		"sharp": "^0.34.5",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0",
		"vaul": "^1.1.2",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@playwright/test": "^1.59.0",
		"@tailwindcss/postcss": "^4.2.2",
		"@tailwindcss/typography": "^0.5.19",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.5.0",
		"@types/nodemailer": "^7.0.11",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/react-lottie": "^1.2.10",
		"@vitejs/plugin-react": "^6.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^29.0.1",
		"prettier": "^3.8.1",
		"react-email": "^5.2.10",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.3",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.2"
	}
}
